{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "removeComments": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/routes/bill.routes.ts",
    "src/routes/calendar.ts",
    "src/routes/chatRoutes.ts",
    "src/routes/clientManagement.ts",
    "src/routes/payments.ts",
    "src/routes/registeredOnboarding.ts",
    "src/routes/subscriptionManagement.ts",
    "src/routes/tasks.ts",
    "src/routes/trialOnboarding.ts",
    "src/routes/ultimateChatRoutes.ts",
    "src/routes/usageEvents.ts",
    "src/services/chat/chatService.ts",
    "src/services/chat/taskService.ts",
    "src/services/ocrService.ts",
    "src/services/pageCollector.ts"
  ]
}
