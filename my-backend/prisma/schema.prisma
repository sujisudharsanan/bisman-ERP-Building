// ============================================================================
// SUBSCRIPTION SYSTEM MODELS
// ============================================================================

/// Subscription plans with pricing and feature definitions
model SubscriptionPlan {
  id                Int      @id @default(autoincrement())
  plan_code         String   @unique @db.VarChar(50)
  name              String   @db.VarChar(100)
  description       String?  @db.Text
  short_description String?  @db.VarChar(255)
  badge_text        String?  @db.VarChar(50)
  
  // Pricing
  price_monthly     Decimal  @default(0) @db.Decimal(12, 2)
  price_yearly      Decimal  @default(0) @db.Decimal(12, 2)
  currency          String   @default("INR") @db.VarChar(3)
  
  // Limits (-1 = unlimited)
  max_users         Int      @default(5)
  max_storage_gb    Int      @default(5)
  max_branches      Int      @default(1)
  max_api_calls_day Int      @default(0)
  
  // Feature flags
  feature_flags     Json     @default("{}")
  
  // Display
  sort_order        Int      @default(0)
  is_popular        Boolean  @default(false)
  is_enterprise     Boolean  @default(false)
  is_active         Boolean  @default(true)
  is_public         Boolean  @default(true)
  
  // CTA
  cta_text          String?  @default("Get Started") @db.VarChar(100)
  cta_action        String?  @default("subscribe") @db.VarChar(50)
  
  // Audit
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  created_by        Int?
  updated_by        Int?
  
  // Relations
  subscriptions     ClientSubscription[]
  scheduled_changes ClientSubscription[] @relation("ScheduledPlan")

  @@index([is_active, is_public])
  @@index([sort_order])
  @@map("subscription_plans")
}

/// Client subscription state and billing
model ClientSubscription {
  id                   Int                @id @default(autoincrement())
  client_id            Int                @unique
  plan_id              Int
  
  // State Machine
  state                subscription_state @default(TRIAL)
  previous_state       subscription_state?
  state_changed_at     DateTime?          @db.Timestamptz(6)
  
  // Billing
  billing_cycle        billing_cycle_type @default(MONTHLY)
  current_period_start DateTime?          @db.Timestamptz(6)
  current_period_end   DateTime?          @db.Timestamptz(6)
  next_billing_date    DateTime?          @db.Timestamptz(6)
  
  // Trial
  trial_start_date     DateTime?          @db.Timestamptz(6)
  trial_end_date       DateTime?          @db.Timestamptz(6)
  trial_converted      Boolean            @default(false)
  
  // Grace Period
  grace_period_start   DateTime?          @db.Timestamptz(6)
  grace_period_end     DateTime?          @db.Timestamptz(6)
  grace_reason         String?            @db.VarChar(255)
  
  // Usage
  current_user_count   Int                @default(0)
  current_storage_used BigInt             @default(0)
  current_api_calls    Int                @default(0)
  
  // Stripe
  stripe_subscription_id String?          @db.VarChar(100)
  stripe_customer_id   String?            @db.VarChar(100)
  
  // Scheduled Changes
  scheduled_plan_id    Int?
  scheduled_change_date DateTime?         @db.Timestamptz(6)
  scheduled_change_type String?           @db.VarChar(20)
  
  // Status
  is_active            Boolean            @default(true)
  cancelled_at         DateTime?          @db.Timestamptz(6)
  cancellation_reason  String?            @db.Text
  
  // Audit
  created_at           DateTime           @default(now()) @db.Timestamptz(6)
  updated_at           DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  
  // Relations
  client               Client             @relation(fields: [client_id], references: [id], onDelete: Cascade)
  plan                 SubscriptionPlan   @relation(fields: [plan_id], references: [id])
  scheduled_plan       SubscriptionPlan?  @relation("ScheduledPlan", fields: [scheduled_plan_id], references: [id])
  audit_logs           SubscriptionAuditLog[]
  invoices             SubscriptionInvoice[]

  @@index([plan_id])
  @@index([state])
  @@index([next_billing_date])
  @@map("client_subscriptions")
}

/// Feature flag definitions (master list)
model FeatureFlagDefinition {
  id            Int                @id @default(autoincrement())
  flag_code     String             @unique @db.VarChar(100)
  name          String             @db.VarChar(150)
  description   String?            @db.Text
  category      String?            @db.VarChar(50)
  default_value feature_flag_value @default(DISABLED)
  
  is_numeric    Boolean            @default(false)
  numeric_unit  String?            @db.VarChar(20)
  
  enforce_at_api Boolean           @default(true)
  enforce_at_ui  Boolean           @default(true)
  
  is_active     Boolean            @default(true)
  sort_order    Int                @default(0)
  created_at    DateTime           @default(now()) @db.Timestamptz(6)

  @@map("feature_flag_definitions")
}

/// Client-specific feature overrides (SuperAdmin controlled)
model ClientFeatureOverride {
  id               Int                @id @default(autoincrement())
  client_id        Int
  flag_code        String             @db.VarChar(100)
  override_value   feature_flag_value
  numeric_override Int?
  reason           String?            @db.Text
  expires_at       DateTime?          @db.Timestamptz(6)
  
  created_by       Int
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  
  client           Client             @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@unique([client_id, flag_code])
  @@index([flag_code])
  @@map("client_feature_overrides")
}

/// Billing overrides for special cases
model BillingOverride {
  id                   Int       @id @default(autoincrement())
  client_id            Int
  override_type        String    @db.VarChar(50)
  
  discount_percent     Decimal?  @db.Decimal(5, 2)
  custom_price         Decimal?  @db.Decimal(12, 2)
  pause_start          DateTime? @db.Timestamptz(6)
  pause_end            DateTime? @db.Timestamptz(6)
  trial_extension_days Int?
  
  valid_from           DateTime  @default(now()) @db.Timestamptz(6)
  valid_until          DateTime? @db.Timestamptz(6)
  
  reason               String    @db.Text
  internal_notes       String?   @db.Text
  
  is_active            Boolean   @default(true)
  applied_at           DateTime? @db.Timestamptz(6)
  
  created_by           Int
  approved_by          Int?
  created_at           DateTime  @default(now()) @db.Timestamptz(6)
  updated_at           DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  
  client               Client    @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@index([is_active, valid_until])
  @@map("billing_overrides")
}

/// Subscription audit log for complete audit trail
model SubscriptionAuditLog {
  id              Int       @id @default(autoincrement())
  client_id       Int?
  subscription_id Int?
  
  action          String    @db.VarChar(100)
  action_category String?   @db.VarChar(50)
  
  old_values      Json?
  new_values      Json?
  
  reason          String?   @db.Text
  ip_address      String?   @db.Inet
  user_agent      String?   @db.Text
  
  actor_type      String    @db.VarChar(20)
  actor_id        Int?
  actor_email     String?   @db.VarChar(255)
  
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  
  client          Client?   @relation(fields: [client_id], references: [id], onDelete: SetNull)
  subscription    ClientSubscription? @relation(fields: [subscription_id], references: [id], onDelete: SetNull)

  @@index([client_id])
  @@index([action])
  @@index([created_at(sort: Desc)])
  @@map("subscription_audit_log")
}

/// Subscription invoices for billing history
model SubscriptionInvoice {
  id               Int       @id @default(autoincrement())
  client_id        Int
  subscription_id  Int?
  
  invoice_number   String    @unique @db.VarChar(50)
  invoice_date     DateTime  @db.Timestamptz(6)
  due_date         DateTime  @db.Timestamptz(6)
  
  subtotal         Decimal   @db.Decimal(12, 2)
  discount         Decimal   @default(0) @db.Decimal(12, 2)
  tax              Decimal   @default(0) @db.Decimal(12, 2)
  total            Decimal   @db.Decimal(12, 2)
  currency         String    @default("INR") @db.VarChar(3)
  
  period_start     DateTime? @db.Timestamptz(6)
  period_end       DateTime? @db.Timestamptz(6)
  
  status           String    @default("draft") @db.VarChar(20)
  paid_at          DateTime? @db.Timestamptz(6)
  
  stripe_invoice_id String?  @db.VarChar(100)
  payment_method   String?   @db.VarChar(50)
  
  pdf_url          String?   @db.Text
  line_items       Json?
  notes            String?   @db.Text
  
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  
  client           Client    @relation(fields: [client_id], references: [id], onDelete: Cascade)
  subscription     ClientSubscription? @relation(fields: [subscription_id], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("subscription_invoices")
}

