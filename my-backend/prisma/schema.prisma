generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model ClientToClientSequence {
  A                String           @db.Uuid
  B                Int
  clients          clients          @relation(fields: [A], references: [id], onDelete: Cascade)
  client_sequences client_sequences @relation(fields: [B], references: [id], onDelete: Cascade)

  @@id([A, B], map: "_ClientToClientSequence_AB_pkey")
  @@index([B], map: "_ClientToClientSequence_B_index")
  @@map("_ClientToClientSequence")
}

