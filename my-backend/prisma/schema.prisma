// ============================================================================

enum subscription_plan_tier {
  STARTER
  PROFESSIONAL
  BUSINESS
  ENTERPRISE
  CUSTOM
}

enum subscription_state {
  TRIAL
  ACTIVE
  UPGRADING
  DOWNGRADING
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
}

