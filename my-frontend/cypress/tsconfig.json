{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "types": ["cypress", "node"],
    "moduleResolution": "Node",
    "module": "ESNext",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "isolatedModules": false,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["./**/*.ts", "./**/*.tsx"],
  "exclude": []
}
